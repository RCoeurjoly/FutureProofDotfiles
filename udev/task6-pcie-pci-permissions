#!/usr/bin/env bash
set -euo pipefail

DEVPATH_ARG="${1:-}"
GROUP_NAME="${TASK6_PCIE_GROUP:-plugdev}"
SYSFS_ROOT="/sys"

fail() {
  echo "task6-pcie-pci-permissions: $*" >&2
  exit 1
}

[[ -n "$DEVPATH_ARG" ]] || fail "missing udev devpath argument"
[[ "$DEVPATH_ARG" == /devices/* ]] || fail "refusing non-device devpath: $DEVPATH_ARG"

DEVICE_DIR="${SYSFS_ROOT}${DEVPATH_ARG}"
[[ -d "$DEVICE_DIR" ]] || fail "missing sysfs device: $DEVICE_DIR"
[[ -f "$DEVICE_DIR/vendor" ]] || fail "missing vendor attribute: $DEVICE_DIR"
[[ -f "$DEVICE_DIR/device" ]] || fail "missing device attribute: $DEVICE_DIR"
[[ -f "$DEVICE_DIR/subsystem_vendor" ]] || fail "missing subsystem_vendor attribute: $DEVICE_DIR"
[[ -f "$DEVICE_DIR/subsystem_device" ]] || fail "missing subsystem_device attribute: $DEVICE_DIR"

vendor="$(<"$DEVICE_DIR/vendor")"
device="$(<"$DEVICE_DIR/device")"
subsystem_vendor="$(<"$DEVICE_DIR/subsystem_vendor")"
subsystem_device="$(<"$DEVICE_DIR/subsystem_device")"

[[ "$vendor" == "0x10ee" ]] || fail "unexpected vendor $vendor"
[[ "$device" == "0x0480" ]] || fail "unexpected device $device"
[[ "$subsystem_vendor" == "0x10ee" ]] || fail "unexpected subsystem_vendor $subsystem_vendor"
case "$subsystem_device" in
  0xabcd) valid_identity=1 ;;
  0xffff) valid_identity=0 ;;
  *) fail "unexpected subsystem_device $subsystem_device" ;;
esac

getent group "$GROUP_NAME" >/dev/null || fail "missing group: $GROUP_NAME"

# Reprogramming the FPGA replaces the PCIe endpoint behind the host's current
# sysfs device. Delegate narrowly scoped recovery nodes as soon as identity is
# known, even if BAR0 has not been assigned yet.
for attr in remove rescan reset; do
  if [[ -e "$DEVICE_DIR/$attr" ]]; then
    chgrp "$GROUP_NAME" "$DEVICE_DIR/$attr"
    chmod 0220 "$DEVICE_DIR/$attr"
  fi
done

PARENT_DIR="$(dirname "$DEVICE_DIR")"
if [[ -e "$PARENT_DIR/rescan" ]]; then
  chgrp "$GROUP_NAME" "$PARENT_DIR/rescan"
  chmod 0220 "$PARENT_DIR/rescan"
fi

# Ensure Linux enables PCI memory decoding only for a fully identified endpoint.
# A stale/corrupt post-reprogramming sysfs instance can report subsystem_device
# 0xffff; for that state we delegate remove/reset/rescan above but do not grant
# BAR access or try to force memory decoding. The enable write can fail for a
# partially enumerated endpoint, so keep it nonfatal after recovery delegation.
if (( valid_identity )); then
  if [[ -w "$DEVICE_DIR/enable" ]]; then
    if ! echo 1 >"$DEVICE_DIR/enable"; then
      echo "task6-pcie-pci-permissions: enable write failed: $DEVICE_DIR/enable" >&2
    fi
  else
    echo "task6-pcie-pci-permissions: enable is not writable: $DEVICE_DIR/enable" >&2
  fi

  bdf="$(basename "$DEVICE_DIR")"
  if command -v /usr/bin/setpci >/dev/null 2>&1; then
    command_value="$(/usr/bin/setpci -s "$bdf" COMMAND 2>/dev/null || true)"
    if [[ "$command_value" =~ ^[0-9A-Fa-f]+$ ]]; then
      command_next=$(printf "%04x" $(( 0x$command_value | 0x0002 )))
      if ! /usr/bin/setpci -s "$bdf" COMMAND="$command_next"; then
        echo "task6-pcie-pci-permissions: setpci COMMAND write failed for $bdf" >&2
      fi
    else
      echo "task6-pcie-pci-permissions: could not read COMMAND for $bdf" >&2
    fi
  else
    echo "task6-pcie-pci-permissions: missing /usr/bin/setpci" >&2
  fi
else
  echo "task6-pcie-pci-permissions: stale endpoint identity; delegating recovery only: $DEVICE_DIR" >&2
fi

for _ in $(seq 1 50); do
  [[ -e "$DEVICE_DIR/resource0" ]] && break
  sleep 0.1
done

if (( valid_identity )); then
  if [[ -e "$DEVICE_DIR/resource0" ]]; then
    chgrp "$GROUP_NAME" "$DEVICE_DIR/resource0"
    chmod 0660 "$DEVICE_DIR/resource0"
  else
    echo "task6-pcie-pci-permissions: BAR0 resource not assigned yet: $DEVICE_DIR/resource0" >&2
  fi
fi
